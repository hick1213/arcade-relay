{
  "description": "ArcadeRelay project lifecycle checks and advisory verification hints.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/session-start.sh",
            "timeout": 10,
            "additionalContextLimit": 2000,
            "statusMessage": "Loading ArcadeRelay state"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/advise-verify.sh",
            "timeout": 10,
            "statusMessage": "Checking ArcadeRelay verification hint"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/session-stop.sh",
            "timeout": 10,
            "statusMessage": "Recording ArcadeRelay session end"
          }
        ]
      }
    ]
  }
}
