# ArcadeRelay — 资产生成 API 密钥
# 复制以创建 .env: cp .env.example .env
# 没有密钥的项目以本地降级模式（质量下降、音乐为占位符级）运行。
# 详情: .claude/docs/assets-config.md

# ── 必需（以完整质量运行时）─────────────────────────────

# fal.ai — 图像生成的 primary（Ideogram V3 透明 / FLUX.2 pro / BiRefNet 背景去除 / LoRA 训练）
# 获取: https://fal.ai/dashboard/keys （推荐预付 ~$10）
FAL_KEY=

# ElevenLabs — SFX (Sound Effects v2) + BGM (Eleven Music)
# 获取: https://elevenlabs.io/ → API Keys
# 重要: 商用必须为 Starter 计划($6/mo)以上。Free 计划仅限非商用。
ELEVENLABS_API_KEY=

# ── 仅像素艺术项目必需 ──────────────────────────────

# Retro Diffusion — 像素艺术专用（瓦片/精灵表/动画）
# 获取: https://www.retrodiffusion.ai/ （推荐预付 ~$5）
RETRO_DIFFUSION_API_KEY=

# ── 可选（用于故障转移）───────────────────────────────

# Ideogram 直连 API（fal 故障时的图像故障转移。seed/style_codes 兼容）
IDEOGRAM_API_KEY=

# OpenAI（三级故障转移。固定 gpt-image-1.5 — gpt-image-2 不支持透明）
OPENAI_API_KEY=

# ── 3D 资产（仅 engine=unity/unreal）─────────────────
# 3D 的 Primary 为 Meshy 直连 API（MESHY_API_KEY 有效时）。第二候选为经 FAL_KEY 的
# fal 托管版 Meshy，仅在两者都失败时降级到 Hunyuan3D/TRELLIS/Rodin/Tripo
# （contract §10 / assets-config.md 3D 路由表）。
# 3D 项目中 MESHY_API_KEY 未设置视为准必需的缺失，由 preflight 警告。
# Free 计划的输出不可商用（Meshy 仅 Pro 以上发放 API 密钥）。

# Meshy 直连 API（text/image-to-3D + auto-rigging + 动画。Pro $20/mo 以上）
MESHY_API_KEY=

# Tripo 直连 API（擅长非人形的 rigging。Pro 以上）
TRIPO_API_KEY=

# ── 预算 ─────────────────────────────────────────────

# 每款游戏的资产生成预算上限（USD）。以 MANIFEST.jsonl 合计强制。
# state/budget.txt 优先。未设置时默认为 20。
ASSET_BUDGET_USD=20
